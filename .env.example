# Application
APP_NAME=Threat Intel Aggregator
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
THREAT_INTEL_API_KEY=change-me
ENABLE_API_KEY_AUTH=true

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=threatintel
DATABASE_USER=threatintel
DATABASE_PASSWORD=threatintel
DATABASE_ECHO=false
DATABASE_URL=

# Feed API keys
OTX_API_KEY=

# Feed scheduler intervals (minutes)
INGEST_INTERVAL_OTX=60
INGEST_INTERVAL_URLHAUS=30
INGEST_INTERVAL_FEODO=120
INGEST_INTERVAL_EMERGING=240
ENABLE_SCHEDULER=true

# Default source weights (used for first-time DB seeding)
DEFAULT_WEIGHT_ALIENVAULT_OTX=0.65
DEFAULT_WEIGHT_URLHAUS=0.80
DEFAULT_WEIGHT_FEODO_TRACKER=0.90
DEFAULT_WEIGHT_EMERGING_THREATS=0.70

# Default recency decay lambdas by IOC type
DEFAULT_LAMBDA_IP=0.015
DEFAULT_LAMBDA_DOMAIN=0.008
DEFAULT_LAMBDA_URL=0.020
DEFAULT_LAMBDA_HASH=0.002

# Dashboard
DASHBOARD_AUTO_REFRESH_SECONDS=60
